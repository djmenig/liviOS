<?xml version="1.0" encoding="utf-8"?>

<image schemaversion="7.5" name="livios-opensuse">
    <description type="system">
        <author>Donald J. Menig</author>
        <contact>livi@suse.com</contact>
        <specification>LiviOS - retro themed terminal-first desktop, openSUSE Leap live ISO</specification>
    </description>

    <preferences>
        <version>1.0.0</version>
        <packagemanager>zypper</packagemanager>
        <locale>en_US</locale>
        <keytable>us</keytable>
        <timezone>Etc/UTC</timezone>
        <rpm-excludedocs>true</rpm-excludedocs>
        <rpm-check-signatures>false</rpm-check-signatures>
        <!-- plymouth bootsplash; the custom 'livios' theme is selected in config.sh.
             rd.kiwi.allow_plymouth keeps plymouth active in the live initrd (KIWI
             stops it by default), so the splash shows during the initrd phase. -->
        <bootsplash-theme>bgrt</bootsplash-theme>
        <!-- 'linudore64' is the custom GRUB theme shipped in root/usr/share/grub2/themes/;
             KIWI searches /usr/share/grub2/themes/<name> and copies it to the ISO boot area.
             The live grub.cfg references it at /boot/grub2/themes/linudore64/theme.txt. -->
        <bootloader-theme>linudore64</bootloader-theme>
        <type image="iso" flags="overlay" firmware="efi" kernelcmdline="quiet loglevel=0 vt.global_cursor_default=0 vt.cur_default=6 console=tty2 splash rd.kiwi.allow_plymouth" hybridpersistent_filesystem="ext4" hybridpersistent="true">
            <bootloader name="grub2" timeout="2"/>
        </type>
    </preferences>

    <users>
        <user password="$1$wYJUgpM5$RXMMeASDc035eX.NbYWFl0" home="/home/demo" name="demo" groups="demo,audio,video,input"/>
        <user password="*" home="/root" name="root" groups="root"/>
    </users>

    <repository type="rpm-md">
        <source path="obsrepositories:/"/>
    </repository>

    <!-- LiviOS local repository: provides GDash (built from source).
         Uses this:// so the path resolves relative to the image description
         directory (editions/opensuse/repos/gdash), which is portable across
         checkout locations and build hosts.
         Run packages/gdash/build-gdash-rpm.sh before building the ISO.
         No imageonly/imageinclude attribute so it is used at build time but
         is not carried into the running system's zypper repository list. -->
    <repository type="rpm-md">
        <source path="this://repos/gdash"/>
    </repository>

    <!-- Live ISO / boot stack + LiviOS dependencies (see packages.list) -->
    <packages type="image">
        <package name="patterns-openSUSE-base"/>
        <package name="systemd"/>
        <package name="grub2"/>
        <package name="grub2-x86_64-efi" arch="x86_64"/>
        <package name="grub2-i386-pc"/>
        <package name="grub2-branding-openSUSE"/>
        <package name="shim"/>
        <package name="kernel-default"/>
        <package name="kernel-firmware-all"/>
        <package name="dracut"/>
        <package name="dracut-kiwi-live"/>
        <package name="plymouth"/>
        <package name="plymouth-theme-bgrt"/>
        <!-- 'script' module plugin required by the custom 'livios' plymouth theme -->
        <package name="plymouth-plugin-script"/>
        <package name="plymouth-branding-openSUSE"/>
        <package name="timezone"/>
        <package name="tar"/>
        <package name="which"/>
        <package name="procps"/>
        <package name="iputils"/>
        <package name="iproute2"/>
        <package name="less"/>
        <package name="bash-completion"/>
        <package name="dhcp-client"/>
        <package name="fontconfig"/>
        <package name="fonts-config"/>
        <!-- LiviOS desktop / application stack -->
        <package name="openbox"/>
        <package name="rxvt-unicode"/>
        <package name="xinit"/>
        <package name="xterm-bin"/>
        <package name="xorg-x11-server"/>
        <package name="xorg-x11-essentials"/>
        <package name="xorg-x11-driver-video"/>
        <package name="xorg-x11-driver-input"/>
        <package name="xorg-x11-fonts"/>
        <package name="unclutter"/>
        <package name="dialog"/>
        <!-- admin: demo user needs sudo to run root commands on the live system -->
        <package name="sudo"/>
        <!-- openbox-session xdg-autostart backend (openSUSE Leap 15.6 = python311) -->
        <package name="python311-pyxdg"/>
        <package name="alsa-utils"/>
        <package name="gcompris-qt"/>
        <!-- gcompris-qt runtime deps: QtQuick.Controls 2.x (openSUSE packaging gap) -->
        <package name="libqt5-qtquickcontrols2"/>
        <package name="libqt5-qtquickcontrols"/>
        <package name="qqc2-desktop-style"/>
        <!-- GDash: Boulder Dash clone (built from source, see packages/gdash/) -->
        <package name="gdash"/>
        <package name="xgalaga-sdl"/>
    </packages>

    <packages type="bootstrap">
        <package name="zypper"/>
        <package name="udev"/>
        <package name="filesystem"/>
        <package name="glibc-locale"/>
        <package name="cracklib-dict-full"/>
        <package name="ca-certificates"/>
        <package name="ca-certificates-mozilla"/>
        <package name="openSUSE-release"/>
    </packages>
</image>
